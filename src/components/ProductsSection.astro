---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="section-wrap products" id="productos">
	<div class="section-heading"><div><p class="eyebrow">PEQUEÑOS DETALLES, GRANDES RECUERDOS</p><h2>Servicios <em>Extras</em></h2></div><p>Productos personalizados para regalar y conservar tus recuerdos.</p></div>
	<button class="product-collection-card" id="products-card" type="button" aria-label="Ver todos los productos personalizables">
		<img id="products-card-image" src={`${base}img/camisa.avif`} alt="Producto personalizable" loading="lazy" />
		<span class="product-collection-shade"></span>
		<span class="product-collection-copy"><small>ESTUDIO FOTOGRÁFICO FÉNIX</small><strong>Productos personalizables</strong><span>Ver catálogo <i>↗</i></span></span>
	</button>
	<p class="fine-print">Productos y precios sujetos a disponibilidad.</p>
</section>
<dialog class="plans-dialog products-dialog" id="products-dialog" aria-labelledby="products-dialog-heading">
	<div class="plans-dialog-inner"><div class="plans-dialog-header"><div><p class="eyebrow">PEQUEÑOS DETALLES, GRANDES RECUERDOS</p><h2 id="products-dialog-heading">Productos personalizables</h2></div><button class="booking-close" id="products-dialog-close" type="button" aria-label="Cerrar productos">×</button></div><div class="product-grid" id="public-product-list"></div></div>
</dialog>
