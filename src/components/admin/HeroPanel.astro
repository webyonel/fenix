---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="admin-panel" id="panel-hero" data-admin-panel="hero">
	<div class="panel-heading"><div><h2>Portada del sitio</h2><p>Personaliza la fotografía y el eslogan que aparecen al entrar a la web.</p></div></div>
	<form class="about-admin-form" id="hero-form">
		<div class="field full"><label for="hero-title-line-input">Primera línea del eslogan</label><input id="hero-title-line-input" name="titleLine" maxlength="60" required /></div>
		<div class="field full"><label for="hero-title-emphasis-input">Segunda línea del eslogan</label><input id="hero-title-emphasis-input" name="titleEmphasis" maxlength="70" required /></div>
		<div class="field"><label for="hero-text-color">Color del eslogan</label><input id="hero-text-color" name="textColor" type="color" value="#ffffff" /></div>
		<div class="field full"><label for="hero-image-file">Fotografía principal</label><div class="image-picker"><img id="hero-image-preview" src={`${base}img/hero-fenix.webp`} alt="Vista previa de la portada" /><input id="hero-image-file" type="file" accept="image/*" /><input id="hero-image-value" name="image" type="hidden" /></div><span class="field-hint">Las imágenes se optimizan y se guardan en Supabase Storage.</span></div>
		<div class="about-save-row"><button class="primary-button" type="submit">Guardar cambios</button></div>
	</form>
</section>
