---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import PlansSection from '../components/PlansSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import GallerySection from '../components/GallerySection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(`${base}og-fenix.jpg`, Astro.site);
const pageTitle = 'Fénix Estudio Fotográfico | Ciego de Ávila';
const pageDescription = 'Estudio Fotográfico Fénix en Ciego de Ávila: fotografía de bodas, quinceañeras, embarazo y niños, impresiones y regalos personalizados. Reserva por WhatsApp.';
const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${canonicalUrl.href}#website`,
			url: canonicalUrl.href,
			name: 'Fénix Estudio Fotográfico',
			inLanguage: 'es-CU',
		},
		{
			'@type': 'LocalBusiness',
			'@id': `${canonicalUrl.href}#estudio-fenix`,
			name: 'Estudio Fotográfico Fénix',
			alternateName: 'Fénix',
			url: canonicalUrl.href,
			image: socialImageUrl.href,
			logo: `${new URL(base, Astro.site).href}logo-fenix.jpg`,
			description: pageDescription,
			telephone: '+5352564951',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Ruperto Castañeda #61 entre Abraham Delgado y Narciso López',
				addressLocality: 'Ciego de Ávila',
				addressCountry: 'CU',
			},
			areaServed: { '@type': 'City', name: 'Ciego de Ávila' },
			sameAs: [
				'https://www.instagram.com/estudiofenixfotos/',
				'https://www.facebook.com/share/1EC6tBuHRV/',
			],
		},
	],
};
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f8f6f1" />
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Estudio Fotográfico Fénix" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="google-site-verification" content="k7rH9lSyBiJckeHqgIiZue_sPkspyrdMgwx_FYFYsU4" />
		<link rel="canonical" href={canonicalUrl.href} />
		<link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Fénix Estudio Fotográfico" />
		<meta property="og:locale" content="es_CU" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={socialImageUrl.href} />
		<meta property="og:image:secure_url" content={socialImageUrl.href} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logotipo de Estudio Fotográfico Fénix" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImageUrl.href} />
		<meta name="twitter:image:alt" content="Logotipo de Estudio Fotográfico Fénix" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<SiteHeader />
		<main>
			<Hero />
			<AboutSection />
			<PlansSection />
			<ProductsSection />
			<GallerySection />
			<ContactSection />
		</main>
		<SiteFooter />
		<script>
			import '../scripts/siteBootstrap';
		</script>
	</body>
</html>
